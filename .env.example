# Environment for scripts/sync-search-index.mjs (run via `pnpm run sync-search`).
# Copy to .env and fill in real values. This is separate from .dev.vars,
# which configures the Cloudflare Pages Function (wrangler/vite) runtime —
# this file is only read by the standalone Node sync script.
# See CLAUDE.md for the required variables and how they're used.

# --- GitHub ---
GIT_GITHUB_OWNER=your-github-username
# Personal Access Token with `repo` scope (for private repos + higher rate limits)
GIT_GITHUB_TOKEN=

# --- GitLab ---
GIT_GITLAB_OWNER=your-gitlab-username
# Personal Access Token with `read_api`, `read_repository` scopes
GIT_GITLAB_TOKEN=

# --- Ingest API (this app's own signed /api/v1/* endpoints) ---
# Entirely optional: if any of the three below is unset, `pnpm run sync-search`
# skips itself and exits 0. Generate a keypair with `pnpm gen:sync-key`; see
# CLAUDE.md for the signed-request protocol these keys authenticate.
SEARCH_API_BASE_URL=https://git.cmss.io
SEARCH_API_KEY_ID=
SEARCH_API_PRIVATE_KEY=
