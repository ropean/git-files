name = "git-files"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]
pages_build_output_dir = "./build/client"

[vars]
PUBLIC_ORIGIN = "https://git.cmss.io"
IS_DEBUG      = "FALSE"

# --- OIDC / SSO (@ropean/sso-client — see https://sc.ropean.org/docs/sso-flow.md) ---
# Register a NEW OAuth client for this app — do not reuse memos' client id,
# redirect URIs are origin-scoped.
OAUTH_ISSUER   = "https://sso.ropean.org/oauth"

[[d1_databases]]
binding      = "DB"
database_name = "git-files-db"
# Placeholder — replace with the real id after: wrangler d1 create git-files-db
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[[kv_namespaces]]
binding = "KV"
# Placeholder — replace with the real id after: wrangler kv namespace create git-files-kv
id      = "REPLACE_WITH_KV_NAMESPACE_ID"
